#!/usr/bin/env python3
"""pack-starters -- write what a client downloads for each starter.

Usage: scripts/pack-starters [--base-url URL] [<starter-id> ...]
       (default: every starter; MOSS=/path/to/moss also builds previews)

Writes, under dist/ (gitignored):

  dist/starters/<id>/                      manifest.json, posters/, site/ -- nothing else
  dist/starters/<id>-<version>.zip         the source: that folder's contents
  dist/starters/<id>-<version>-preview.zip the built site, files at the zip root,
                                           without the share-card images
                                           (only when MOSS is set)
  dist/starters/<id>-<version>-poster-light.jpg
  dist/starters/<id>-<version>-poster-dark.jpg
                                           the two posters again, standalone, so a client can
                                           draw a picker card without fetching a zip
  dist/starters/<id>-<version>.json        which moss built the preview, and the hash of
                                           each zip and poster it describes (only when MOSS is set)
  dist/starters/index-entries.json         one registry-index entry per starter

Both zips are deterministic: entries sorted, fixed timestamps and
permissions, so packing the same input twice gives the same bytes. The source
zip's root holds manifest.json, posters/ and site/ directly (no wrapping
folder). .cut, fixups.sh and README.md are registry tooling and never ship.

The preview is built from a scratch copy of site/ with `moss build --strict`;
nothing is ever built inside the repository, because moss writes `uid:` lines
into the files it builds.

The .json file is the third asset of a starter's release. The index builder
reads preview_moss_version from it rather than from the repository at index
time, so the entry says which moss built the bytes the release holds, and it
checks the two hashes in it against the zips it downloaded.

Entry URLs are <base-url>/starter-<id>-v<version>/<zip name>; the base
defaults to this repository's GitHub release downloads.

Prints each zip's name, sha256 and size in bytes.
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STARTERS = ROOT / "starters"
OUT = ROOT / "dist" / "starters"
STAMP = (1980, 1, 1, 0, 0, 0)  # the earliest time a zip can store
DEFAULT_BASE = "https://github.com/Symbiosis-Lab/moss-registry/releases/download"
POSTERS = (("light", "home-light.jpg"), ("dark", "home-dark.jpg"))
ENTRY_FIELDS = ("credit", "language", "order", "min_moss_version", "tour")
# Left out of the preview zip: the share-card image moss draws for each page.
# Only <meta> tags and JSON-LD name them, for other sites' link previews; no
# page shows one, and they were a third of the largest preview.
PREVIEW_SKIP = ("_moss/og/",)


def shipped_files(starter: Path):
    files = [starter / "manifest.json"]
    for sub in ("posters", "site"):
        files += [p for p in (starter / sub).rglob("*")
                  if p.is_file() and p.name != ".DS_Store"]
    return [(p.relative_to(starter).as_posix(), p) for p in sorted(files)]


def write_zip(zpath: Path, entries):
    """entries: (name inside the zip, file on disk); written sorted by name."""
    with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as z:
        for name, path in sorted(entries):
            info = zipfile.ZipInfo(name, STAMP)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o644 << 16
            info.create_system = 3  # unix, so the same on every host
            z.writestr(info, path.read_bytes(), compresslevel=9)
    data = zpath.read_bytes()
    digest = hashlib.sha256(data).hexdigest()
    print(f"{zpath.name}  sha256={digest}  size={len(data)}")
    return digest, len(data)


def moss_version(moss: str) -> str:
    out = subprocess.run([moss, "--version"], capture_output=True, text=True, check=True).stdout
    m = re.search(r"\d+\.\d+\.\d+\S*", out)
    return m.group(0) if m else out.strip()


def build_preview(moss: str, starter: Path):
    """Build a scratch copy of site/ and return (tempdir, build output dir)."""
    scratch = Path(tempfile.mkdtemp(prefix="starter-preview-"))
    copy = scratch / "site"
    shutil.copytree(starter / "site", copy)
    r = subprocess.run([moss, "build", str(copy), "--strict"], capture_output=True, text=True)
    if r.returncode != 0:
        shutil.rmtree(scratch, ignore_errors=True)
        sys.exit(f"pack-starters: moss build --strict failed for {starter.name}:\n"
                 + "\n".join((r.stdout + r.stderr).strip().splitlines()[-10:]))
    for cand in (".moss/build.nosync/current", ".moss/build/current"):
        if (copy / cand).is_dir():
            return scratch, copy / cand
    shutil.rmtree(scratch, ignore_errors=True)
    sys.exit(f"pack-starters: no build output for {starter.name}")


def pack(sid: str, base: str, moss):
    starter = STARTERS / sid
    m = json.loads((starter / "manifest.json").read_text(encoding="utf-8"))
    version = m["version"]
    folder = OUT / sid
    if folder.exists():
        shutil.rmtree(folder)
    files = shipped_files(starter)
    for name, p in files:
        dest = folder / name
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(p, dest)
    tag = f"starter-{sid}-v{version}"
    src_name = f"{sid}-{version}.zip"
    digest, size = write_zip(OUT / src_name, files)
    entry = {
        "type": "starter", "id": sid, "version": version,
        "display_name": m["name"], "description": m["line"],
    }
    entry.update({k: m[k] for k in ENTRY_FIELDS})
    if "demo_url" in m:
        entry["demo_url"] = m["demo_url"]
    entry.update({"download_url": f"{base}/{tag}/{src_name}", "sha256": digest, "size_bytes": size})
    poster_hashes = {}
    for scheme, fname in POSTERS:
        data = (starter / "posters" / fname).read_bytes()
        name = f"{sid}-{version}-poster-{scheme}.jpg"
        (OUT / name).write_bytes(data)
        poster_hashes[scheme] = hashlib.sha256(data).hexdigest()
        entry.update({
            f"poster_{scheme}_url": f"{base}/{tag}/{name}",
            f"poster_{scheme}_sha256": poster_hashes[scheme],
            f"poster_{scheme}_size_bytes": len(data),
        })
    if moss:
        scratch, built = build_preview(moss, starter)
        try:
            built_files = [(p.relative_to(built).as_posix(), p) for p in built.rglob("*")
                           if p.is_file() and p.name != ".DS_Store"]
            built_files = [(name, p) for name, p in built_files
                           if not name.startswith(PREVIEW_SKIP)]
            prev_name = f"{sid}-{version}-preview.zip"
            pdigest, psize = write_zip(OUT / prev_name, built_files)
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
        meta = {
            "schema_version": 1, "id": sid, "version": version,
            "preview_moss_version": moss_version(moss),
            "source_sha256": digest, "preview_sha256": pdigest,
            "poster_light_sha256": poster_hashes["light"],
            "poster_dark_sha256": poster_hashes["dark"],
        }
        (OUT / f"{sid}-{version}.json").write_text(
            json.dumps(meta, indent=2) + "\n", encoding="utf-8")
        entry.update({
            "preview_url": f"{base}/{tag}/{prev_name}", "preview_sha256": pdigest,
            "preview_size_bytes": psize, "preview_moss_version": meta["preview_moss_version"],
        })
    return m["order"], entry


def main():
    ap = argparse.ArgumentParser(description="Pack starters for download.")
    ap.add_argument("ids", nargs="*")
    ap.add_argument("--base-url", default=DEFAULT_BASE)
    args = ap.parse_args()
    ids = args.ids or sorted(p.name for p in STARTERS.iterdir() if (p / "manifest.json").is_file())
    moss = os.environ.get("MOSS") or None
    if not moss:
        print("pack-starters: MOSS is not set; skipping preview zips and the preview_* index fields")
    OUT.mkdir(parents=True, exist_ok=True)
    entries = [pack(sid, args.base_url.rstrip("/"), moss) for sid in ids]
    entries = [e for _, e in sorted(entries, key=lambda t: (t[0], t[1]["id"]))]
    (OUT / "index-entries.json").write_text(
        json.dumps(entries, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(f"index-entries.json  {len(entries)} entries")
    return 0


if __name__ == "__main__":
    sys.exit(main())
