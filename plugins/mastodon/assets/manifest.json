{
  "name": "mastodon",
  "version": "0.2.1",
  "display_name": "Mastodon",
  "description": "Post a copy of each new post to your Mastodon account, linked back to your site",
  "author": "Symbiosis Lab",
  "min_moss_version": "0.15.27",
  "preview": true,
  "entry": "main.bundle.js",
  "network": {
    "hosts": [],
    "setting_hosts": [
      "server"
    ]
  },
  "global_name": "MastodonPlugin",
  "icon": "icon.svg",
  "contributes": {
    "channel": {
      "display_name": "Mastodon",
      "setup": {
        "settings": [
          { "key": "server", "type": "string", "required": true, "label": "Server", "description": "The address of the server your account is on, such as https://mastodon.social." },
          { "key": "access_token", "type": "secret", "label": "Access token", "description": "Made on your server under Preferences, Development, New application, with the scopes read:statuses and write:statuses." }
        ]
      },
      "syndication": {
        "forms": ["short", "thread", "teaser"],
        "max_chars": 500,
        "counting": "graphemes",
        "link_chars": 23,
        "host_setting": "server"
      }
    },
    "site_settings": {
      "settings": [
        { "key": "account", "type": "acct", "label": "Account", "placeholder": "@name@server" }
      ]
    },
    "identity": [
      { "link": "me", "href": "https://{account.host}/@{account.user}" },
      { "meta": "fediverse:creator", "content": "@{account.user}@{account.host}" }
    ]
  }
}
