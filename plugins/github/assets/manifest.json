{
  "name": "github",
  "version": "1.5.3",
  "display_name": "GitHub",
  "description": "Deploy to GitHub Pages via GitHub Actions",
  "author": "moss team",
  "min_moss_version": "0.7.23",
  "preview": true,
  "entry": "main.bundle.js",
  "capabilities": [
    "deploy"
  ],
  "domain": "github.com",
  "global_name": "GithubPlugin",
  "icon": "icon.svg",
  "config": {
    "auto_commit": true,
    "video_max_size_mb": 75
  },
  "config_schema": {
    "auto_commit": "boolean",
    "video_max_size_mb": "number"
  },
  "requires": [
    "execute_binary"
  ]
}
