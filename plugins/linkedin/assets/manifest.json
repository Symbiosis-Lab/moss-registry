{
  "name": "linkedin",
  "version": "0.1.0",
  "display_name": "LinkedIn",
  "description": "Post a copy of each new post to your LinkedIn profile, linked back to your site",
  "author": "Symbiosis Lab",
  "min_moss_version": "0.15.19",
  "preview": true,
  "entry": "main.bundle.js",
  "global_name": "LinkedinPlugin",
  "icon": "icon.svg",
  "domains": ["linkedin.com", "www.linkedin.com"],
  "contributes": {
    "channel": {
      "display_name": "LinkedIn",
      "setup": {
        "settings": [
          { "key": "access_token", "type": "secret", "label": "Access token", "description": "Made with LinkedIn's token generator for your app, with the scopes openid, profile and w_member_social. It lasts 60 days.", "help_url": "https://www.linkedin.com/developers/tools/oauth/token-generator" },
          { "key": "api", "type": "string", "hidden": true, "default": "https://api.linkedin.com" }
        ]
      },
      "syndication": {
        "forms": ["short", "teaser"],
        "max_chars": 3000,
        "counting": "utf16"
      }
    }
  }
}
