# Dependencies
node_modules/
target/

# Build outputs: dist/ is gitignored per package, not here, so each plugin's
# .gitignore stands on its own when the directory is read in isolation. CI
# rebuilds dist/ from source, which is what makes "what a reviewer reads is what
# ships" true.

# Coverage
coverage/
*.lcov

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Lock files (optional - remove if you want to track them)
# package-lock.json
# Cargo.lock
.worktrees/
